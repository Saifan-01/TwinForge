# Copy this file to .env and fill in your own values. Never commit .env.

# --- MongoDB ---
# Local MongoDB Community (default)
MONGO_URI=mongodb://localhost:27017/
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=iot_digital_twin

# --- Flask ---
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-string
HOST=127.0.0.1
PORT=5000

# --- Security (required) ---
# API key for scripts/devices (sent as the X-API-Key header)
API_KEY=replace-with-a-long-random-string
# Dashboard login accounts created by `python db/seed_data.py`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=choose-another-password

# --- Device simulator ---
SIMULATOR_TICK_SECONDS=2
SIMULATOR_DEVICE_COUNT=60
